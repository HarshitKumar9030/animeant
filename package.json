{
  "name": "animeant-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/canvas --noEmit && tsc -p apps/playground --noEmit && tsc -p packages/three --noEmit",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@12.14.0"
}
