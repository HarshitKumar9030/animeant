{
  "name": "@animeant/three",
  "version": "0.1.0",
  "description": "three.js view for Animeant 3D figures",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022 --sourcemap --external three",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": { "@animeant/core": "workspace:^" },
  "peerDependencies": { "three": ">=0.160.0" },
  "devDependencies": { "three": "0.187.0", "@types/three": "0.187.0" },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } }
  },
  "repository": { "type": "git", "url": "git+https://github.com/HarshitKumar9030/animeant.git", "directory": "packages/three" },
  "homepage": "https://github.com/HarshitKumar9030/animeant#readme",
  "keywords": ["animation", "three", "threejs", "skeletal", "ik"],
  "author": "Harshit Kumar",
  "license": "MIT"
}
